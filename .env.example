# Database (Local Postgres or Supabase direct/session pooler)
DATABASE_URL=postgresql+asyncpg://circuitmentor:circuitmentor@localhost:5432/circuitmentor
POSTGRES_USER=circuitmentor
POSTGRES_PASSWORD=circuitmentor
POSTGRES_DB=circuitmentor

# Auth (Session JWT in httpOnly cookie cm_token)
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth (Native Authorization Code + PKCE)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/v1/auth/google/callback
WEB_URL=http://localhost:5173
COOKIE_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Mentor (OpenRouter SSE - supports any OpenRouter model e.g. anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MENTOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional fallback: direct Anthropic key
ANTHROPIC_API_KEY=your-anthropic-api-key
